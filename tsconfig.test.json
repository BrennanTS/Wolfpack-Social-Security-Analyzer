{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* `node` on top of the app's `vite/client`: the lib tests read the SSA
       life tables off disk to stub `fetch`, and the sweep resolves paths. */
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/vendor/ssa-tools/*"]
    },

    /* Bundler mode — identical to tsconfig.app.json, so a type that checks in
       a test checks the same way in the code it tests. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. `noUnusedLocals`/`noUnusedParameters` are deliberately OFF
       here and on in the app: a test fixture that builds a field the assertion
       does not read is documenting the shape, not leaving litter, and a
       half-written test is a normal intermediate state. Everything that
       matters for correctness — assignability, missing properties, wrong
       argument types — is identical to the app's. */
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/testSetup.ts",
    "validation/**/*.ts",
    "validation/**/*.tsx"
  ]
}
