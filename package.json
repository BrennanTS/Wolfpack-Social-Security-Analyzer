{
  "name": "social-security-web-app",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "PW_DEV=1 playwright test",
    "validate": "npm run lint && npm run test && npm run test:e2e",
    "crosscheck:ssatools": "playwright test --config playwright.crosscheck.config.ts",
    "fixtures:gen": "node validation/scripts/gen-fixtures.mjs",
    "record": "npm run record:ssatools",
    "record:ssatools": "node validation/scripts/record.mjs ssatools",
    "record:app": "node validation/scripts/record.mjs app",
    "prepare": "git config core.hooksPath .githooks",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
